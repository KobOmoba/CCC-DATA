rules_version = '2';
// CCC Parish Portal - Firestore security rules.
// Roles live in users/{uid}: { role: 'super_admin' | 'hq' | 'parish_admin', parishId, email }.
// Nobody can read or write anything without signing in.
// Privacy (NDPA 2023):
//  - A parish's records are private to that parish's admin.
//  - super_admin sees per-parish totals, the clergy register, and members the parish
//    flags "important". Never ordinary members, attendance or giving.
//  - hq sees per-parish totals only.
// No self-registration: super_admin creates each parish and an invite (email + secret code).
// The invited admin signs up with that email and claims the invite.
// Clergy can never be app admins (adminEmails / clergyIndex cross-check).
// Member and clergy numbers come from a per-parish counter, are the document id,
// and are never reused (counter only goes up by 1; records cannot be deleted).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function docAt(p) { return path('/databases/' + database + '/documents/' + p); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return hasProfile() ? profile().role : ''; }
    function isSuper() { return role() == 'super_admin'; }
    function isHQ() { return role() == 'hq'; }
    function myEmail() { return signedIn() && request.auth.token.email is string ? request.auth.token.email.lower() : ''; }
    // Parish admins only get in while their parish is Approved (not Suspended).
    function isParishAdminOf(parishId) {
      return role() == 'parish_admin' && profile().parishId == parishId
        && get(/databases/$(database)/documents/parishes/$(parishId)).data.status == 'Approved';
    }
    function isClergyEmail(e) { return exists(/databases/$(database)/documents/clergyIndex/$(e)); }
    function isAdminEmail(e) { return exists(/databases/$(database)/documents/adminEmails/$(e)); }

    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function optInt(d, k, lo, hi) { return !(k in d) || d[k] == null || (d[k] is int && d[k] >= lo && d[k] <= hi); }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optDate(d, k) { return !(k in d) || d[k] == null || d[k] == '' || isDate(d[k]); }
    function optImage(d, k, max) {
      return !(k in d) || d[k] == null || d[k] == ''
        || (d[k] is string && d[k].size() <= max && d[k].matches('^data:image/(jpeg|png|webp);base64,.*'));
    }
    function isEmail(v) { return v is string && v.size() <= 120 && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }

    // ---- Numbers: CCC-{PARISH}-{CITY}-MBR-001 / -CLG-001 (lettering from the parish doc), from parishes/{p}/meta/counters.
    // Old records keep their old-style ids (CCC-MBR-001); new numbers continue the same counter, so no clash.
    function lettering(p) { return get(docAt('parishes/' + p)).data.parishLetters + '-' + get(docAt('parishes/' + p)).data.cityLetters; }
    function numId(p, tail, n) { return 'CCC-' + lettering(p) + '-' + tail + pad3(n); }
    // Type of a number, old or new style: 'MBR', 'CLG', 'BRT', 'CHD', 'TEN', 'DTH'.
    function noType(no) { return no.split('-')[no.split('-').size() - 2]; }
    function isNo(v, types) { return v is string && v.matches('^CCC-([A-Z]{2,4}-[A-Z]{2,4}-)?(' + types + ')-[0-9]{3,}$'); }
    function pad3(n) { return n < 10 ? '00' + string(n) : (n < 100 ? '0' + string(n) : string(n)); }
    function counterPath(p) { return /databases/$(database)/documents/parishes/$(p)/meta/counters; }
    function counterBefore(p, k) { return get(counterPath(p)).data[k]; }
    function counterAfter(p, k) { return getAfter(counterPath(p)).data[k]; }
    // Creating record `id` must take exactly the next number in the same write.
    function takesNextNumber(p, k, prefix, id) {
      return counterAfter(p, k) == counterBefore(p, k) + 1 && id == numId(p, prefix, counterAfter(p, k));
    }

    // ---- Member / clergy record ----
    // Rank lines by gender. One regex = one expression (a 28-item list costs ~30).
    // Male line: 28 ranks (batch 1). Female line: 9 ranks (batch 8, confirmed). 'Lace Elder Sister / Lace Senior Elder Sister'
    // is ONE rank (the name differs by region).
    function isMaleRank(r) {
      return r.matches('^(Brother|Elder Brother|Cape Elder Brother|Full Elder Brother|Senior Elder Brother|Superior Senior Elder Brother|Assistant Leader|Leader|Senior Leader|Superior Senior Leader|Honorary Assistant Evangelist|Assistant Evangelist|Honorary Evangelist|Evangelist|Honorary Senior Evangelist|Senior Evangelist|Special Most Senior Evangelist|Most Senior Evangelist|Special Venerable Most Senior Evangelist|Venerable Most Senior Evangelist|Assistant Superior Evangelist|Superior Evangelist|Assistant Venerable Superior Evangelist|Venerable Superior Evangelist|Assistant Most Superior Evangelist|Most Superior Evangelist|Supreme Evangelist|Pastor Reverend)$');
    }
    function isFemaleRank(r) {
      return r.matches('^(Sister|Elder Sister|Cape Elder Sister|Senior Elder Sister|Lace Elder Sister / Lace Senior Elder Sister|Superior Senior Elder Sister|Lace Superior Senior Elder Sister|Assistant Mother Celestial|Mother Celestial)$');
    }
    function isRank(r, g) { return g == 'Male' ? isMaleRank(r) : isFemaleRank(r); }
    function personKeys() {
      return ['memberNo', 'fullName', 'nameLower', 'gender', 'maritalStatus', 'address', 'phone', 'phoneDigits',
        'email', 'rank', 'occupation', 'dobDay', 'dobMonth', 'dobYear', 'anointDay', 'anointMonth', 'anointYear',
        'nokName', 'nokAddress', 'nokPhone', 'photo', 'important', 'status', 'consentGiven', 'consentDate',
        'createdAt', 'updatedAt'];
    }
    // Compact helpers: Firestore caps a request at 1000 evaluated expressions, so these stay small.
    function s(v, max) { return v is string && v.size() <= max; }
    function n(v, lo, hi) { return v == null || (v is int && v >= lo && v <= hi); }
    function validPerson(d, id) {
      return d.memberNo == id && str(d.fullName, 120) && d.nameLower == d.fullName.lower()
        && d.gender in ['Male', 'Female']
        && d.maritalStatus in ['Single', 'Married', 'Widowed', 'Divorced', 'Separated']
        && s(d.get('address', ''), 200) && s(d.get('phone', ''), 20) && s(d.get('phoneDigits', ''), 20)
        && s(d.get('occupation', ''), 80) && s(d.get('nokName', ''), 120) && s(d.get('nokAddress', ''), 200)
        && s(d.get('nokPhone', ''), 20)
        && (d.get('email', '') == '' || (isEmail(d.email) && d.email == d.email.lower()))
        && (d.get('rank', '') == '' || isRank(d.rank, d.gender))
        && n(d.dobDay, 1, 31) && d.dobDay != null && n(d.dobMonth, 1, 12) && d.dobMonth != null
        && n(d.get('dobYear', null), 1900, 2100) && n(d.get('anointDay', null), 1, 31)
        && n(d.get('anointMonth', null), 1, 12) && n(d.get('anointYear', null), 1900, 2100)
        && (d.get('photo', '') == '' || (s(d.photo, 110000) && d.photo.matches('^data:image/(jpeg|png|webp);base64,.*')))
        && d.get('important', false) is bool
        && d.consentGiven == true && isDate(d.consentDate);
    }
    // Member statuses: Active, Ordained (now clergy), Diaspora (moved abroad, kept as a link),
    // TransferredOut (sent to another parish; history link only).
    function validMember(d, id) {
      return d.keys().hasOnly(personKeys().concat(['ordainedAs', 'abroadCountry', 'abroadCity', 'abroadParish',
          'abroadSince', 'transferId', 'lifeNo', 'lifeParishCode', 'fromNo', 'deathId']))
        && validPerson(d, id) && d.status in ['Active', 'Ordained', 'Diaspora', 'TransferredOut', 'Called to glory']
        && (d.status != 'Ordained' || str(d.get('ordainedAs', ''), 30))
        && (d.status != 'Diaspora' || (str(d.get('abroadCountry', ''), 80) && s(d.get('abroadCity', ''), 80)
              && s(d.get('abroadParish', ''), 120) && isDate(d.get('abroadSince', ''))))
        && s(d.get('lifeNo', ''), 30) && s(d.get('lifeParishCode', ''), 12) && s(d.get('transferId', ''), 40);
    }
    // Allowed status moves for an existing member record.
    function memberMoveOk(p, id) {
      let o = resource.data;
      let d = request.resource.data;
      return (o.status == 'Active' && d.status in ['Active', 'Ordained', 'Diaspora', 'TransferredOut'])
        || (o.status == 'Diaspora' && d.status in ['Active', 'Diaspora', 'TransferredOut'])
        || (o.status == 'Ordained' && d.status == 'Ordained')
        // Called to glory: only with a death record for this exact member in the same write. Never deleted.
        || (o.status in ['Active', 'Diaspora'] && d.status == 'Called to glory' && diedHere(p, d, id))
        // Back home only if the transfer was declined or cancelled.
        || (o.status == 'TransferredOut' && d.status == 'Active'
            && get(docAt('transfers/' + o.transferId)).data.status in ['Declined', 'Cancelled'])
        || (o.status == 'TransferredOut' && d.status == 'TransferredOut' && d.transferId == o.transferId);
    }
    // Sending a member away: the transfer doc for this exact member is created in the same write.
    function sendsTransfer(p, id) {
      let d = request.resource.data;
      return d.status != 'TransferredOut' || resource.data.status == 'TransferredOut'
        || (getAfter(docAt('transfers/' + d.transferId)).data.fromParish == p
            && getAfter(docAt('transfers/' + d.transferId)).data.memberNo == id
            && !exists(docAt('transfers/' + d.transferId)));
    }
    // A member created by accepting a transfer carries the transfer id and the life-long number.
    function arrivesByTransfer(p, d) {
      return (!('transferId' in d) && !('lifeNo' in d) && !('lifeParishCode' in d))
        || (get(docAt('transfers/' + d.transferId)).data.status == 'Pending'
            && getAfter(docAt('transfers/' + d.transferId)).data.status == 'Accepted'
            && getAfter(docAt('transfers/' + d.transferId)).data.toParish == p
            && d.lifeNo == get(docAt('transfers/' + d.transferId)).data.lifeNo
            && d.lifeParishCode == get(docAt('transfers/' + d.transferId)).data.lifeParishCode);
    }

    // ---- Departments ----
    function isDept(x) { return x in ['parochial', 'choir', 'ict', 'sidemen', 'prophets', 'sundayschool']; }
    // One doc per (department, member). Clergy can never join: only CCC-MBR numbers of an
    // Active member (not Ordained, not abroad, not transferred) may be Current.
    function validDeptMember(p, d, id) {
      return d.keys().hasOnly(['dept', 'memberNo', 'fullName', 'role', 'status', 'joinedDate', 'leftDate', 'updatedAt'])
        && isUnit(p, d.dept) && isNo(d.memberNo, 'MBR')
        && id == d.dept + '_' + d.memberNo && str(d.fullName, 120) && s(d.get('role', ''), 40)
        && isDate(d.joinedDate) && d.status in ['Current', 'Former']
        && (d.status == 'Former' ? isDate(d.get('leftDate', ''))
            : getAfter(docAt('parishes/' + p + '/members/' + d.memberNo)).data.status == 'Active');
    }
    function validTerm(p, d, id) {
      return isUnit(p, id) && d.keys().hasOnly(['termStart', 'termEnd', 'updatedAt'])
        && isDate(d.termStart) && isDate(d.termEnd) && d.termEnd > d.termStart;
    }
    function validClergy(d, id) {
      return d.keys().hasOnly(personKeys().concat(['formerMemberNo', 'joinedDate', 'leftDate', 'leaveReason',
          'transferredTo', 'letterId', 'serviceRecord', 'deathId']))
        && validPerson(d, id) && d.status in ['Active', 'Former']
        // Clergy must carry an email so the clergy-not-admin rule can be enforced.
        && d.email != '' && !isAdminEmail(d.email)
        && getAfter(docAt('clergyIndex/' + d.email)).data.parishId != null
        && s(d.get('formerMemberNo', ''), 30) && s(d.get('transferredTo', ''), 120) && s(d.get('letterId', ''), 60)
        && s(d.get('joinedDate', ''), 10) && s(d.get('leftDate', ''), 10)
        && d.get('leaveReason', '') in ['', 'Transfer', 'Retired', 'Called to glory', 'Other']
        && d.get('serviceRecord', []) is list && d.get('serviceRecord', []).size() <= 40
        && (d.status == 'Active' || isDate(d.get('leftDate', '')));
    }
    // Number, identity and consent date never change after creation.
    function keepsIdentity() {
      return request.resource.data.memberNo == resource.data.memberNo
        && request.resource.data.consentDate == resource.data.consentDate;
    }


    // ---- Births (0-2), Sunday School Children (2-12), Teenagers (12-18), Deaths (Phase 4) ----
    // Own number series, one counter doc each: parishes/{p}/meta/{brt|chd|ten|dth} = { n }.
    function seriesInfo() {
      return { 'brt': ['births', 'BRT-'], 'chd': ['children', 'CHD-'], 'ten': ['teens', 'TEN-'], 'dth': ['deaths', 'DTH-'] };
    }
    function takesNextIn(p, k, id) {
      return getAfter(docAt('parishes/' + p + '/meta/' + k)).data.n
          == (exists(docAt('parishes/' + p + '/meta/' + k)) ? get(docAt('parishes/' + p + '/meta/' + k)).data.n : 0) + 1
        && id == numId(p, seriesInfo()[k][1], getAfter(docAt('parishes/' + p + '/meta/' + k)).data.n);
    }
    // Dates as yyyymmdd numbers; 'today' is the server's UTC date, so nobody can fake an age.
    function ymdNum(v) { return int(v.split('-')[0]) * 10000 + int(v.split('-')[1]) * 100 + int(v.split('-')[2]); }
    function todayNum() { return request.time.year() * 10000 + request.time.month() * 100 + request.time.day(); }
    function ageAtLeast(dob, years) { return todayNum() >= ymdNum(dob) + years * 10000; }
    function youngKeys() {
      return ['no', 'fullName', 'nameLower', 'gender', 'dob', 'status', 'fromNo', 'movedTo', 'movedAt', 'movedBy', 'deathId',
        'consentGiven', 'consentDate', 'createdAt', 'updatedAt'];
    }
    // Full date of birth (with year) is REQUIRED here: moves happen by age.
    function validYoung(d, id) {
      return d.no == id && str(d.fullName, 120) && d.nameLower == d.fullName.lower() && d.gender in ['Male', 'Female']
        && isDate(d.dob) && ymdNum(d.dob) <= todayNum() + 1
        && d.status in ['Active', 'Moved', 'Called to glory'] && s(d.get('fromNo', ''), 30)
        && d.consentGiven == true && isDate(d.consentDate);
    }
    // A linked parent / clergy number must exist in this parish (or be left blank and typed as free text).
    function linkOk(p, v) {
      return v == '' || (isNo(v, 'MBR') && exists(docAt('parishes/' + p + '/members/' + v)))
        || (isNo(v, 'CLG') && exists(docAt('parishes/' + p + '/clergy/' + v)));
    }
    function validBirth(p, d, id) {
      return d.keys().hasOnly(youngKeys().concat(['place', 'fatherNo', 'fatherName', 'motherNo', 'motherName',
          'namingDate', 'officiant', 'officiantName']))
        && validYoung(d, id) && s(d.get('place', ''), 120) && s(d.get('fatherName', ''), 120) && s(d.get('motherName', ''), 120)
        && optDate(d, 'namingDate') && s(d.get('officiantName', ''), 160)
        && linkOk(p, d.get('fatherNo', '')) && linkOk(p, d.get('motherNo', ''))
        && (d.get('officiant', '') == '' || linkOk(p, d.officiant));
    }
    function validKid(d, id) {
      return d.keys().hasOnly(youngKeys().concat(['parentName', 'parentPhone', 'address']))
        && validYoung(d, id) && s(d.get('parentName', ''), 250) && s(d.get('parentPhone', ''), 20) && s(d.get('address', ''), 200);
    }
    // Created by an automatic move: the older record is marked Moved -> this id in the same write.
    function arrivesFrom(p, col, d, id) {
      return !('fromNo' in d)
        || (get(docAt('parishes/' + p + '/' + col + '/' + d.fromNo)).data.status == 'Active'
            && getAfter(docAt('parishes/' + p + '/' + col + '/' + d.fromNo)).data.status == 'Moved'
            && getAfter(docAt('parishes/' + p + '/' + col + '/' + d.fromNo)).data.movedTo == id);
    }
    function diedHere(p, d, id) { return getAfter(docAt('parishes/' + p + '/deaths/' + d.get('deathId', 'x'))).data.personNo == id; }
    // Status changes: Active -> Moved (only at the right age, new record created in the same write, nothing else changes),
    // Active -> Called to glory (with a death record). Moved and Called to glory are final: records are never deleted.
    function youngMoveOk(p, nextCol, age, id) {
      let o = resource.data;
      let d = request.resource.data;
      return d.no == o.no && d.consentDate == o.consentDate && d.get('fromNo', '') == o.get('fromNo', '') && o.status == 'Active'
        && (d.status == 'Active'
          || (d.status == 'Called to glory' && diedHere(p, d, id))
          || (d.status == 'Moved' && ageAtLeast(o.dob, age)
              && d.diff(o).affectedKeys().hasOnly(['status', 'movedTo', 'movedAt', 'movedBy', 'updatedAt'])
              && d.movedBy == request.auth.uid && d.movedTo is string
              && getAfter(docAt('parishes/' + p + '/' + nextCol + '/' + d.movedTo)).data.fromNo == id
              && !exists(docAt('parishes/' + p + '/' + nextCol + '/' + d.movedTo))));
    }
    function colOf(no) { return { 'MBR': 'members', 'CLG': 'clergy', 'BRT': 'births', 'CHD': 'children', 'TEN': 'teens' }[noType(no)]; }
    function validDeath(p, d, id) {
      return d.keys().hasOnly(['no', 'fullName', 'nameLower', 'personNo', 'gender', 'dateOfDeath', 'age', 'place', 'burialDate',
          'officiant', 'officiantName', 'informant', 'notes', 'createdAt', 'updatedAt'])
        && d.no == id && str(d.fullName, 120) && d.nameLower == d.fullName.lower()
        && d.get('gender', '') in ['', 'Male', 'Female'] && isDate(d.dateOfDeath)
        && n(d.get('age', null), 0, 130) && s(d.get('place', ''), 120) && optDate(d, 'burialDate')
        && s(d.get('officiantName', ''), 160) && (d.get('officiant', '') == '' || linkOk(p, d.officiant))
        && s(d.get('informant', ''), 120) && s(d.get('notes', ''), 500)
        // A linked person is marked Called to glory (clergy: Former) in the same write.
        && (d.get('personNo', '') == ''
            || (isNo(d.personNo, 'MBR|CLG|BRT|CHD|TEN')
                && getAfter(docAt('parishes/' + p + '/' + colOf(d.personNo) + '/' + d.personNo)).data.get('deathId', '') == id));
    }

    // ---- Attendance (Phase 3) ----
    // Old simple records {serviceDate, serviceType, headcount} stay valid and readable.
    // A scheduled service has id <date>_<serviceKey> and splits the headcount into men/women/children/visitors.
    function isServiceKey(k) {
      return k.matches('^(sunday|bible|vigil_sidemen|wakati|seekers|wed_evening|new_moon|vigil_prophets|fri_evening|special|other)$');
    }
    function cnt(d, k) { return d.get(k, -1) is int && d.get(k, -1) >= 0 && d.get(k, -1) <= 100000; }
    function validAttendance(p, d, id) {
      return d.keys().hasOnly(['serviceDate', 'serviceType', 'headcount', 'serviceKey', 'serviceTime', 'men', 'women',
          'children', 'visitors', 'ledBy', 'ledByName', 'notes', 'specialId', 'updatedAt'])
        && isDate(d.serviceDate) && str(d.serviceType, 60)
        && d.headcount is int && d.headcount >= 0 && d.headcount <= 100000
        && (!('serviceKey' in d) || (isServiceKey(d.serviceKey) && id == d.serviceDate + '_' + d.serviceKey
            + (d.serviceKey == 'special' ? '_' + d.get('specialId', '') : '')
            && cnt(d, 'men') && cnt(d, 'women') && cnt(d, 'children') && cnt(d, 'visitors')
            && d.headcount == d.men + d.women + d.children + d.visitors
            && s(d.get('serviceTime', ''), 5) && s(d.get('notes', ''), 1000) && s(d.get('ledByName', ''), 160)
            && (d.get('ledBy', '') == '' || exists(docAt('parishes/' + p + '/clergy/' + d.ledBy)))));
    }
    // Units: the six fixed departments plus admin-defined units (parishes/{p}/units/u_xxx).
    // Named attendance and absenteeism live in each unit's own register (short lists), not a whole-church tick-list.
    function isUnit(p, x) {
      return isDept(x) || (x is string && x.matches('^u_[A-Za-z0-9]{1,30}$') && exists(docAt('parishes/' + p + '/units/' + x)));
    }
    function validDeptAttendance(p, d, id) {
      return d.keys().hasOnly(['dept', 'date', 'kind', 'present', 'notes', 'updatedAt'])
        && isUnit(p, d.dept) && isDate(d.date) && id == d.dept + '_' + d.date
        && d.kind in ['Practice', 'Meeting', 'Class', 'Service duty', 'Other']
        && d.present is list && d.present.size() <= 300 && s(d.get('notes', ''), 500);
    }
    function validCleaning(d, id) {
      return d.keys().hasOnly(['date', 'assigned', 'came', 'names', 'notes', 'updatedAt'])
        && isDate(d.date) && id == d.date
        && d.assigned is list && d.assigned.size() <= 100 && d.came is list && d.came.size() <= 100
        && d.names is map && d.names.size() <= 200 && s(d.get('notes', ''), 500);
    }
    function validSpecial(d) {
      return d.keys().hasOnly(['name', 'date', 'time', 'notes', 'createdAt'])
        && str(d.name, 60) && isDate(d.date) && d.time is string && d.time.matches('^[0-2][0-9]:[0-5][0-9]$')
        && s(d.get('notes', ''), 500);
    }
    // Visitors are personal data too (NDPA): consent required, private to the parish.
    function validVisitor(p, d) {
      return d.keys().hasOnly(['name', 'nameLower', 'phone', 'phoneDigits', 'invitedBy', 'firstVisit', 'serviceType',
          'status', 'notes', 'memberNo', 'consentGiven', 'createdAt', 'updatedAt'])
        && str(d.name, 120) && d.nameLower == d.name.lower() && s(d.get('phone', ''), 20) && s(d.get('phoneDigits', ''), 20)
        && s(d.get('invitedBy', ''), 120) && isDate(d.firstVisit) && s(d.get('serviceType', ''), 60)
        && s(d.get('notes', ''), 500) && d.consentGiven == true
        && d.status in ['New', 'Contacted', 'Returned', 'Member', 'Not interested']
        && (d.status != 'Member' || (d.get('memberNo', '') is string
            && existsAfter(docAt('parishes/' + p + '/members/' + d.get('memberNo', 'x')))));
    }
    function validFinance(d) {
      return d.keys().hasOnly(['transactionDate', 'contributorName', 'contributionType', 'amount'])
        && isDate(d.transactionDate) && str(d.contributorName, 120) && str(d.contributionType, 60)
        && (d.amount is int || d.amount is float) && d.amount > 0 && d.amount <= 100000000;
    }
    function nonNegInt(d, k) { return d.get(k, 0) is int && d.get(k, 0) >= 0; }
    function validStats(d) {
      return d.keys().hasOnly(['memberCount', 'clergyCount', 'formerClergyCount', 'attendanceTotal', 'serviceCount',
          'financeTotal', 'financeCount', 'diasporaCount', 'byType', 'visitorCount', 'updatedAt',
          'birthCount', 'childCount', 'teenCount', 'deathCount'])
        && nonNegInt(d, 'birthCount') && nonNegInt(d, 'childCount') && nonNegInt(d, 'teenCount') && nonNegInt(d, 'deathCount')
        && (!('byType' in d) || (d.byType is map && d.byType.size() <= 20))
        && nonNegInt(d, 'visitorCount')
        && nonNegInt(d, 'diasporaCount')
        && nonNegInt(d, 'memberCount') && nonNegInt(d, 'clergyCount') && nonNegInt(d, 'formerClergyCount')
        && nonNegInt(d, 'attendanceTotal') && nonNegInt(d, 'serviceCount') && nonNegInt(d, 'financeCount')
        && (d.get('financeTotal', 0) is int || d.get('financeTotal', 0) is float) && d.get('financeTotal', 0) >= 0;
    }
    // Parish lettering (e.g. IJY + ABK) goes on every new number: CCC-IJY-ABK-MBR-001, -CLG-, -BRT-, -DTH-... Unique worldwide through
    // parishLettering/{PARISH-CITY}, created in the same write. Set once by super_admin; never changed after.
    function letteringOk(pid) {
      let d = request.resource.data;
      let o = resource == null ? {} : resource.data;
      return (d.get('parishLetters', '') == o.get('parishLetters', '') && d.get('cityLetters', '') == o.get('cityLetters', ''))
        || (o.get('parishLetters', '') == '' && d.parishLetters.matches('^[A-Z]{2,4}$') && d.cityLetters.matches('^[A-Z]{2,4}$')
            && getAfter(docAt('parishLettering/' + d.parishLetters + '-' + d.cityLetters)).data.parishId == pid
            && !exists(docAt('parishLettering/' + d.parishLetters + '-' + d.cityLetters)));
    }
    function parishFieldKeys() { return ['name', 'address', 'mapsUrl', 'city', 'state', 'country', 'continent', 'logo', 'updatedAt']; }
    function validParish(d) {
      return d.keys().hasOnly(parishFieldKeys().concat(['status', 'createdAt', 'code', 'parishLetters', 'cityLetters']))
        && (!('code' in d) || (d.code is string && d.code.matches('^[A-Z0-9]{6}$')))
        && str(d.name, 120) && d.status in ['Approved', 'Suspended']
        && optStr(d, 'address', 200) && optStr(d, 'city', 80) && optStr(d, 'state', 80) && optStr(d, 'country', 80)
        && (!('continent' in d) || d.continent in ['', 'Africa', 'Europe', 'Asia', 'North America', 'South America', 'Oceania', 'Antarctica'])
        && (!('mapsUrl' in d) || d.mapsUrl == '' || (d.mapsUrl is string && d.mapsUrl.size() <= 300 && d.mapsUrl.matches('^https://.*')))
        && optImage(d, 'logo', 110000);
    }

    // ---- Accounts ----
    // Users read their own profile. super_admin assigns roles but can never make a clergy an admin.
    // An invited admin may create their OWN parish_admin profile by claiming a valid invite in the same write.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow create: if (isSuper() && (request.resource.data.role != 'parish_admin'
              || (isEmail(request.resource.data.get('email', '')) && !isClergyEmail(request.resource.data.email))))
        || (signedIn() && request.auth.uid == uid && claimsInvite(request.resource.data));
      allow update: if isSuper() && (request.resource.data.role != 'parish_admin'
              || (isEmail(request.resource.data.get('email', '')) && !isClergyEmail(request.resource.data.email)));
      allow delete: if isSuper();
    }
    function claimsInvite(d) {
      return d.keys().hasOnly(['role', 'parishId', 'email', 'inviteCode']) && d.role == 'parish_admin'
        && d.email == myEmail() && myEmail() != '' && !isClergyEmail(myEmail())
        && inviteValidFor(d.inviteCode, d.parishId, myEmail())
        && getAfter(docAt('invites/' + d.inviteCode)).data.usedBy == request.auth.uid
        && getAfter(docAt('adminEmails/' + myEmail())).data.uid == request.auth.uid;
    }
    function inviteValidFor(code, parishId, email) {
      return code is string && exists(docAt('invites/' + code))
        && get(docAt('invites/' + code)).data.email == email
        && get(docAt('invites/' + code)).data.parishId == parishId
        && get(docAt('invites/' + code)).data.get('usedBy', null) == null;
    }

    // Invites: id is a random secret code. Only super_admin creates or lists them.
    // The invited person can read their own (they must know the code) and mark it used, once.
    match /invites/{code} {
      allow create: if isSuper() && code.size() >= 16
        && request.resource.data.keys().hasOnly(['email', 'parishId', 'role', 'createdAt', 'usedBy'])
        && isEmail(request.resource.data.email) && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role == 'parish_admin' && request.resource.data.get('usedBy', null) == null
        && existsAfter(docAt('parishes/' + request.resource.data.parishId))
        && !isClergyEmail(request.resource.data.email);
      allow get: if isSuper() || (signedIn() && resource.data.email == myEmail());
      allow list, delete: if isSuper();
      allow update: if signedIn() && resource.data.email == myEmail() && resource.data.get('usedBy', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(docAt('users/' + request.auth.uid));
    }
    // One doc per admin email (lower case): lets the clergy rules refuse admin emails.
    match /adminEmails/{email} {
      allow read: if isSuper();
      allow create: if (isSuper() || (signedIn() && email == myEmail() && request.resource.data.uid == request.auth.uid
              && existsAfter(docAt('users/' + request.auth.uid))))
        && request.resource.data.keys().hasOnly(['uid']) && !isClergyEmail(email);
      allow update, delete: if isSuper();
    }
    // One doc per clergy email (lower case), written with the clergy record.
    match /clergyIndex/{email} {
      allow read: if isSuper();
      allow create, update: if request.resource.data.keys().hasOnly(['parishId', 'clergyId'])
        && isParishAdminOf(request.resource.data.parishId)
        && getAfter(docAt('parishes/' + request.resource.data.parishId + '/clergy/' + request.resource.data.clergyId)).data.email == email;
      allow delete: if false;
    }

    // Old self-registration path is closed. Super admin may read / clean up old requests.
    match /parishRequests/{uid} {
      allow read, delete: if isSuper();
    }

    match /parishes/{parishId} {
      allow read: if isSuper() || isHQ() || isParishAdminOf(parishId);
      allow create: if isSuper() && validParish(request.resource.data) && letteringOk(parishId);
      allow update: if (isSuper() && validParish(request.resource.data) && letteringOk(parishId))
        || (isParishAdminOf(parishId) && validParish(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(parishFieldKeys()));
      allow delete: if isSuper();

      match /meta/counters {
        allow read: if isParishAdminOf(parishId) || isSuper();
        allow create: if isSuper() && request.resource.data == { 'clg': 0, 'mbr': 0 };
        // Exactly one counter moves up by exactly 1, and the record with that number is created in the same write.
        allow update: if isParishAdminOf(parishId) && request.resource.data.keys().hasOnly(['clg', 'mbr'])
          && ((request.resource.data.clg == resource.data.clg + 1 && request.resource.data.mbr == resource.data.mbr
                && existsAfter(docAt('parishes/' + parishId + '/clergy/' + numId(parishId, 'CLG-', request.resource.data.clg)))
                && !exists(docAt('parishes/' + parishId + '/clergy/' + numId(parishId, 'CLG-', request.resource.data.clg))))
           || (request.resource.data.mbr == resource.data.mbr + 1 && request.resource.data.clg == resource.data.clg
                && existsAfter(docAt('parishes/' + parishId + '/members/' + numId(parishId, 'MBR-', request.resource.data.mbr)))
                && !exists(docAt('parishes/' + parishId + '/members/' + numId(parishId, 'MBR-', request.resource.data.mbr)))));
      }

      // Number series for births, children, teens and deaths: each goes up by exactly 1 with its record.
      match /meta/{k} {
        allow read: if k in seriesInfo() && isParishAdminOf(parishId);
        allow create, update: if k in seriesInfo() && isParishAdminOf(parishId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1
          && existsAfter(docAt('parishes/' + parishId + '/' + seriesInfo()[k][0] + '/' + numId(parishId, seriesInfo()[k][1], request.resource.data.n)))
          && !exists(docAt('parishes/' + parishId + '/' + seriesInfo()[k][0] + '/' + numId(parishId, seriesInfo()[k][1], request.resource.data.n)));
      }
      // Births (0-2), Sunday School Children (2-12), Teenagers (12-18), Deaths: private to the parish.
      // Super Admin and HQ see only the totals in parishStats.
      match /births/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create: if isParishAdminOf(parishId) && validBirth(parishId, request.resource.data, id)
          && request.resource.data.status == 'Active' && !('fromNo' in request.resource.data)
          && takesNextIn(parishId, 'brt', id);
        allow update: if isParishAdminOf(parishId) && validBirth(parishId, request.resource.data, id)
          && youngMoveOk(parishId, 'children', 2, id);
        allow delete: if false;
      }
      match /children/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create: if isParishAdminOf(parishId) && validKid(request.resource.data, id)
          && request.resource.data.status == 'Active' && takesNextIn(parishId, 'chd', id)
          && arrivesFrom(parishId, 'births', request.resource.data, id);
        allow update: if isParishAdminOf(parishId) && validKid(request.resource.data, id)
          && youngMoveOk(parishId, 'teens', 12, id);
        allow delete: if false;
      }
      match /teens/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create: if isParishAdminOf(parishId) && validKid(request.resource.data, id)
          && request.resource.data.status == 'Active' && takesNextIn(parishId, 'ten', id)
          && arrivesFrom(parishId, 'children', request.resource.data, id);
        allow update: if isParishAdminOf(parishId) && validKid(request.resource.data, id)
          && youngMoveOk(parishId, 'members', 18, id);
        allow delete: if false;
      }
      match /deaths/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create: if isParishAdminOf(parishId) && validDeath(parishId, request.resource.data, id)
          && takesNextIn(parishId, 'dth', id);
        allow update: if isParishAdminOf(parishId) && validDeath(parishId, request.resource.data, id)
          && request.resource.data.get('personNo', '') == resource.data.get('personNo', '');
        allow delete: if false;
      }

      // Church members: private to the parish; super_admin reads only those flagged important.
      match /members/{memberId} {
        allow read: if isParishAdminOf(parishId) || (isSuper() && resource.data.important == true);
        allow create: if isParishAdminOf(parishId) && validMember(request.resource.data, memberId)
          && request.resource.data.status == 'Active'
          && takesNextNumber(parishId, 'mbr', 'MBR-', memberId)
          && arrivesByTransfer(parishId, request.resource.data)
          && arrivesFrom(parishId, 'teens', request.resource.data, memberId) && !('deathId' in request.resource.data);
        allow update: if isParishAdminOf(parishId) && validMember(request.resource.data, memberId) && keepsIdentity()
          && request.resource.data.get('lifeNo', '') == resource.data.get('lifeNo', '')
          && memberMoveOk(parishId, memberId) && sendsTransfer(parishId, memberId);
        allow delete: if false; // numbers are never reused, so records are never deleted
      }
      // Clergy register: parish admin + super_admin.
      match /clergy/{clergyId} {
        allow read: if isParishAdminOf(parishId) || isSuper();
        allow create: if isParishAdminOf(parishId) && validClergy(request.resource.data, clergyId)
          && request.resource.data.status == 'Active'
          && takesNextNumber(parishId, 'clg', 'CLG-', clergyId);
        allow update: if isParishAdminOf(parishId) && validClergy(request.resource.data, clergyId) && keepsIdentity();
        allow delete: if false;
      }
      // Transfer letters (photo of the letter), kept apart from the clergy doc.
      match /letters/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create: if isParishAdminOf(parishId)
          && request.resource.data.keys().hasOnly(['clergyId', 'image', 'createdAt'])
          && str(request.resource.data.clergyId, 30) && optImage(request.resource.data, 'image', 400000);
        allow update, delete: if false;
      }
      // Departments: term dates per department, and one membership doc per (department, member).
      match /departments/{dept} {
        allow read: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validTerm(parishId, request.resource.data, dept);
        allow delete: if false;
      }
      match /deptMembers/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validDeptMember(parishId, request.resource.data, id)
          && (resource == null || (resource.data.dept == request.resource.data.dept && resource.data.memberNo == request.resource.data.memberNo));
        allow delete: if false; // former members stay on record
      }
      match /families/{id} {
        allow read, delete: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId)
          && request.resource.data.keys().hasOnly(['name', 'memberNos', 'roles', 'updatedAt'])
          && str(request.resource.data.name, 120)
          && request.resource.data.memberNos is list && request.resource.data.memberNos.size() <= 30
          && request.resource.data.roles is map;
      }
      // Attendance: parish admin only. Super admin and HQ see totals in parishStats, never these.
      match /attendance/{id} {
        allow read, delete: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validAttendance(parishId, request.resource.data, id);
      }
      match /units/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && id.matches('^u_[A-Za-z0-9]{1,30}$')
          && request.resource.data.keys().hasOnly(['name', 'createdAt']) && str(request.resource.data.name, 60);
        allow delete: if false; // registers keep pointing at it
      }
      match /deptAttendance/{id} {
        allow read, delete: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validDeptAttendance(parishId, request.resource.data, id);
      }
      match /cleaning/{date} {
        allow read, delete: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validCleaning(request.resource.data, date);
      }
      match /specialServices/{id} {
        allow read, delete: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validSpecial(request.resource.data);
      }
      match /visitors/{id} {
        allow read: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validVisitor(parishId, request.resource.data);
        allow delete: if isParishAdminOf(parishId); // NDPA: remove on request
      }
      match /finances/{id} {
        allow read, delete: if isParishAdminOf(parishId);
        allow create, update: if isParishAdminOf(parishId) && validFinance(request.resource.data);
      }
    }

    // ---- Parish codes: short public code -> parish id, used to address a member transfer ----
    match /parishCodes/{code} {
      allow get: if isSuper() || role() == 'parish_admin';
      allow list: if isSuper();
      allow create: if isSuper() && request.resource.data.keys().hasOnly(['parishId'])
        && getAfter(docAt('parishes/' + request.resource.data.parishId)).data.code == code;
      allow update, delete: if false;
    }

    // ---- Parish lettering index: one doc per PARISH-CITY lettering, so no two parishes share it ----
    match /parishLettering/{id} {
      allow get: if isSuper() || role() == 'parish_admin';
      allow list: if isSuper();
      allow create: if isSuper() && request.resource.data.keys().hasOnly(['parishId'])
        && id.matches('^[A-Z]{2,4}-[A-Z]{2,4}$')
        && getAfter(docAt('parishes/' + request.resource.data.parishId)).data.parishLetters + '-'
           + getAfter(docAt('parishes/' + request.resource.data.parishId)).data.cityLetters == id;
      allow update, delete: if false;
    }

    // ---- Member transfers between parishes (with the member's consent) ----
    // Old parish sends (member becomes TransferredOut in the same write). New parish accepts by
    // creating its own record that keeps the life-long number. Super admin never reads these.
    function validTransferCreate(d) {
      return d.keys().hasOnly(['memberNo', 'lifeNo', 'lifeParishCode', 'fromParish', 'fromName', 'fromCity', 'fromCountry',
          'toParish', 'toCode', 'person', 'consentGiven', 'consentDate', 'status', 'createdAt'])
        && isParishAdminOf(d.fromParish) && d.status == 'Pending'
        && d.consentGiven == true && isDate(d.consentDate) && d.person is map
        && str(d.lifeNo, 30) && str(d.lifeParishCode, 12)
        && d.toParish == get(docAt('parishCodes/' + d.toCode)).data.parishId && d.toParish != d.fromParish
        && getAfter(docAt('parishes/' + d.fromParish + '/members/' + d.memberNo)).data.status == 'TransferredOut'
        && d.fromCity == get(docAt('parishes/' + d.fromParish)).data.get('city', '')
        && d.fromCountry == get(docAt('parishes/' + d.fromParish)).data.get('country', '')
        && s(d.fromName, 120);
    }
    match /transfers/{id} {
      allow read: if isParishAdminOf(resource.data.fromParish) || isParishAdminOf(resource.data.toParish);
      allow create: if validTransferCreate(request.resource.data);
      allow update: if resource.data.status == 'Pending' && (
          // New parish accepts: its new member record (with this transfer id) is created in the same write.
          (isParishAdminOf(resource.data.toParish) && request.resource.data.status == 'Accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'newMemberNo', 'decidedAt'])
            && getAfter(docAt('parishes/' + resource.data.toParish + '/members/' + request.resource.data.newMemberNo)).data.transferId == id
            && !exists(docAt('parishes/' + resource.data.toParish + '/members/' + request.resource.data.newMemberNo)))
          || (isParishAdminOf(resource.data.toParish) && request.resource.data.status == 'Declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']))
          || (isParishAdminOf(resource.data.fromParish) && request.resource.data.status == 'Cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])));
      allow delete: if false;
    }

    // ---- Migration flows: places and year only, no personal data. Super admin reads these. ----
    // 'Transfer': written by the new parish when it accepts (id = transfer id).
    // 'Abroad': written by a parish when a member moves abroad (id = abroad_<parish>_<memberNo>_<date>).
    function validFlow(d, id) {
      return d.keys().hasOnly(['kind', 'fromCity', 'fromCountry', 'toCity', 'toCountry', 'year'])
        && s(d.fromCity, 80) && s(d.fromCountry, 80) && s(d.toCity, 80) && s(d.toCountry, 80)
        && d.year is int && d.year >= 2000 && d.year <= 2100
        && ((d.kind == 'Transfer'
              && getAfter(docAt('transfers/' + id)).data.status == 'Accepted'
              && isParishAdminOf(getAfter(docAt('transfers/' + id)).data.toParish)
              && d.fromCity == getAfter(docAt('transfers/' + id)).data.fromCity
              && d.fromCountry == getAfter(docAt('transfers/' + id)).data.fromCountry
              && d.toCity == profileParish().get('city', '') && d.toCountry == profileParish().get('country', ''))
          || (d.kind == 'Abroad' && isParishAdminOf(profile().parishId)
              && id == 'abroad_' + profile().parishId + '_' + id.split('_')[2] + '_'
                 + getAfter(docAt('parishes/' + profile().parishId + '/members/' + id.split('_')[2])).data.abroadSince
              && getAfter(docAt('parishes/' + profile().parishId + '/members/' + id.split('_')[2])).data.status == 'Diaspora'
              && d.toCountry == getAfter(docAt('parishes/' + profile().parishId + '/members/' + id.split('_')[2])).data.abroadCountry
              && d.fromCity == profileParish().get('city', '') && d.fromCountry == profileParish().get('country', '')));
    }
    function profileParish() { return get(docAt('parishes/' + profile().parishId)).data; }
    match /flows/{id} {
      allow read: if isSuper();
      allow create: if role() == 'parish_admin' && validFlow(request.resource.data, id);
      allow update, delete: if false;
    }

    // Collection-group reads for the super_admin world view.
    match /{p=**}/clergy/{id} {
      allow read: if isSuper();
    }
    match /{p=**}/members/{id} {
      allow read: if isSuper() && resource.data.important == true;
    }

    // Per-parish totals only (no names). HQ + super read; the parish's own writes keep it current.
    match /parishStats/{parishId} {
      allow read: if isSuper() || isHQ() || isParishAdminOf(parishId);
      allow create: if isSuper() && validStats(request.resource.data);
      allow update: if (isSuper() || isParishAdminOf(parishId)) && validStats(request.resource.data);
      allow delete: if isSuper();
    }

    match /circulars/{id} {
      allow read: if hasProfile() && (isSuper() || isHQ() || role() == 'parish_admin');
      allow write: if isSuper() || isHQ();
    }
  }
}
